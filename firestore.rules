rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Rol guardado en el documento de la persona. Con exists() para no reventar
    // cuando la ficha aún no existe (primer inicio de sesión).
    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', '')
        : '';
    }

    // Admin por dos vías: la lista fija de correos de arranque (con correo
    // verificado) o el rol 'admin' asignado en la ficha del usuario. La segunda
    // vía es la que permite entrar aunque el correo no esté verificado, porque
    // el rol sólo lo puede poner otro admin.
    function isPlatformAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email in [
            'dbitdev@gmail.com',
            'admin@come.mx',
            'parradabito@gmail.com'
          ])
        || roleOf(request.auth.uid) == 'admin'
      );
    }

    // Curador: puede curar contenido, pero no las acciones reservadas al admin
    // (borrar, destacar, estrellas Michelin). Todo admin es también curador.
    function isCurator() {
      return isSignedIn() && (isPlatformAdmin() || roleOf(request.auth.uid) == 'curator');
    }

    function ownsExistingVenue() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function keepsVenueOwnership() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Campos que sólo la redacción puede fijar: si un negocio pudiera marcarse
    // solo, cualquiera se pondría estrella Michelin o calificación 5.
    function noSetsEditorialFields() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny([
          'name', 'restaurantName', 'address', 'city', 'zone', 'tier',
          'cuisine_type', 'is_verified', 'is_active', 'is_claimed',
          'managed_by', 'access_level', 'created_by', 'created_at',
          'isMichelin', 'rating', 'featured', 'status', 'awards', 'reservas'
        ]);
    }

    function isShortText(value, max) {
      return value is string && value.size() <= max;
    }

    // Campos de autoridad de un lugar que un curador NO puede tocar (sí el admin):
    // distinción Michelin, destacado, calificación y estado editorial.
    function curatorSafeVenue() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isMichelin', 'michelinStars', 'featured', 'rating', 'status', 'managed_by', 'userId', 'reservas']);
    }

    // ── Restaurantes y lugares ──────────────────────────────────
    match /come/{venueId} {
      // Directorio público: la lectura queda abierta a propósito. Restringirla
      // por `status` rompería todos los listados, porque una consulta de
      // colección falla entera si un solo documento no pasa la regla; para eso
      // habría que filtrar con where('status','==','published') en el cliente y
      // rellenar el campo en los documentos antiguos. Mientras tanto, lo
      // pendiente se oculta en el cliente y las reglas de create/update impiden
      // que alguien se ponga solo estrella, rating o destacado.
      allow read: if true;
      allow create: if isPlatformAdmin()
                    // Curador: alta editorial, pero sin auto-otorgar Michelin ni destacado.
                    || (isCurator()
                        && request.resource.data.get('isMichelin', false) == false
                        && request.resource.data.get('featured', false) == false)
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.get('status', '') == 'pending'
                        && request.resource.data.get('isMichelin', false) == false);
      allow update: if isPlatformAdmin()
                    // Curador: edita todo el contenido menos los campos de autoridad.
                    || (isCurator() && curatorSafeVenue())
                    || (resource.data.get('managed_by', '') != 'admin'
                        && ownsExistingVenue() && keepsVenueOwnership() && noSetsEditorialFields());
      allow delete: if isPlatformAdmin()
                    || (resource.data.get('managed_by', '') != 'admin' && ownsExistingVenue());
    }

    // ── Directorio de chefs ─────────────────────────────────────
    match /chefs/{document=**} {
      allow read: if true;
      // Curador: puede crear y editar fichas, pero no estrellas/Michelin ni destacado.
      allow create: if isCurator()
                    && (isPlatformAdmin()
                        || (request.resource.data.get('estrellas', 0) == 0
                            && request.resource.data.get('michelinStars', 0) == 0));
      allow update: if isPlatformAdmin()
                    || (isCurator()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['estrellas', 'michelinStars', 'featured', 'userId']));
      allow delete: if isPlatformAdmin();
    }

    // ── Nominaciones de chefs (formulario público) ──────────────
    // Se validan tamaños para que el formulario anónimo no sirva de vertedero.
    // Los campos deben coincidir con /nomina-chef.
    match /chef_nominations/{nominationId} {
      allow read: if isPlatformAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'specialty', 'bio', 'trajectory', 'awards',
                          'instagram', 'tiktok', 'twitter', 'portfolio', 'photoUrl',
                          'isMichelin', 'status', 'createdAt'])
                    && isShortText(request.resource.data.get('name', ''), 120)
                    && request.resource.data.name.size() > 0
                    && isShortText(request.resource.data.get('specialty', ''), 160)
                    && isShortText(request.resource.data.get('bio', ''), 2000)
                    && isShortText(request.resource.data.get('trajectory', ''), 2000)
                    && isShortText(request.resource.data.get('awards', ''), 1000)
                    && request.resource.data.get('status', '') == 'pending';
      allow update, delete: if isPlatformAdmin();
    }

    // ── Nominaciones de lugares (formulario público) ────────────
    // Van a su propia colección: una nominación anónima no debe aparecer en el
    // sitio hasta que la redacción la publique en /come.
    match /place_nominations/{nominationId} {
      allow read: if isPlatformAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                         ['restaurantName', 'category', 'description', 'address',
                          'awards', 'instagram', 'tiktok', 'twitter', 'website',
                          'photoUrl', 'isMichelin', 'status', 'createdAt'])
                    && isShortText(request.resource.data.get('restaurantName', ''), 160)
                    && request.resource.data.restaurantName.size() > 0
                    && isShortText(request.resource.data.get('category', ''), 120)
                    && isShortText(request.resource.data.get('description', ''), 2000)
                    && isShortText(request.resource.data.get('address', ''), 300)
                    && isShortText(request.resource.data.get('awards', ''), 1000)
                    && request.resource.data.get('status', '') == 'pending';
      allow update, delete: if isPlatformAdmin();
    }

    // ── Contenido editorial ─────────────────────────────────────
    match /news/{document=**} {
      allow read: if true;
      allow create, update: if isCurator();
      allow delete: if isPlatformAdmin();
    }
    match /guides/{document=**} {
      allow read: if true;
      allow create, update: if isCurator();
      allow delete: if isPlatformAdmin();
    }
    match /premios_especiales/{document=**} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ── Datos de cada persona (direcciones, favoritos) ──────────
    match /users/{userId} {
      // La redacción necesita listar personas para poder asignarles un negocio o
      // designar curadores; los datos de cada quien siguen siendo suyos.
      allow read: if isPlatformAdmin() || (isSignedIn() && request.auth.uid == userId);
      // El rol es autoridad: sólo un admin lo pone o lo cambia. Un usuario puede
      // editar su propia ficha SIEMPRE que no toque su `role` (si no, cualquiera
      // se haría admin o curador solo).
      allow create: if isSignedIn() && request.auth.uid == userId
                    && !('role' in request.resource.data);
      allow update: if isPlatformAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isPlatformAdmin();
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Reservaciones ───────────────────────────────────────────
    // Altas y cambios sólo por la API (/api/reservas), que valida horario y cupo
    // dentro de una transacción; desde el cliente sería imposible evitar la
    // sobreventa. Cada quien puede leer sus propias reservas ("Mis reservas").
    match /reservations/{reservaId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // Contadores de cupo por horario: internos del servidor.
    match /reservation_slots/{cupoId} {
      allow read, write: if false;
    }

    // Tokens OAuth y refresh tokens: sólo existen en servidor mediante Admin SDK.
    match /social_connections/{connectionId} {
      allow read, write: if false;
    }

    // Las reclamaciones contienen datos de contacto y evidencia. Se crean y
    // resuelven exclusivamente en el servidor; el usuario sólo puede leer las
    // suyas y la redacción puede consultar toda la bandeja.
    match /profile_claims/{claimId} {
      allow read: if isPlatformAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
